generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ════════════════════════════════════════
// ENUMS
// ════════════════════════════════════════

enum Role {
  admin
  teacher
  student
}

enum GroupStatus {
  active
  finished
  archived
}

enum EnrollmentStatus {
  active
  archived
}

enum EvaluationType {
  automatic
  manual
}

enum ActivityType {
  workshop
  quiz
}

enum SubmissionStatus {
  submitted
  graded
  returned
}

enum Difficulty {
  basic
  intermediate
  advanced
}

enum TopicActivityKind {
  check
  activity
}

enum JobType {
  user_provisioning
  group_provisioning
  group_teardown
  certificate_email
}

enum JobStatus {
  pending
  processing
  completed
  failed
}

enum Theme {
  system
  light
  dark
}

enum EventType {
  auth_login
  auth_logout
  activity_submitted
  activity_checked
  activity_graded
  activity_created
  activity_updated
  activity_enabled
  activity_disabled
  activity_due_extended
  teacher_registered
  teacher_toggled
  group_created
  group_finished
  group_archived
  group_deleted
  student_registered
  csv_imported
}

// ════════════════════════════════════════
// IDENTIDAD
// ════════════════════════════════════════

model User {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique @db.VarChar(255)
  name       String    @db.VarChar(255)
  role       Role
  google_id  String?   @unique @db.VarChar(255)
  active     Boolean   @default(true)
  last_login DateTime? @map("last_login")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  student      Student?
  teacher      Teacher?
  settings     Settings?
  linuxAccount LinuxAccount?
  auditEvents  AuditEvent[]
  jobs         Job[]
}

model Student {
  user_id    String   @id @db.Uuid
  user       User     @relation(fields: [user_id], references: [id])
  code       String   @unique @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  enrollments Enrollment[]
}

model Teacher {
  user_id    String   @id @db.Uuid
  user       User     @relation(fields: [user_id], references: [id])
  code       String   @unique @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  taughtGroups Group[]
  gradedSubs   SubmissionManualDetail[]
}

model Settings {
  user_id            String   @id @db.Uuid
  user               User     @relation(fields: [user_id], references: [id])
  terminal_font_size Int      @default(16)
  terminal_font_family String @default("Menlo, Monaco, 'Courier New', monospace") @db.VarChar(96)
  theme              Theme    @default(system)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

model LinuxAccount {
  user_id           String   @id @db.Uuid
  user              User     @relation(fields: [user_id], references: [id])
  linux_username    String   @unique @db.VarChar(32)
  linux_provisioned Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

// ════════════════════════════════════════
// ORGANIZACIÓN ACADÉMICA
// ════════════════════════════════════════

model Group {
  id           String      @id @default(uuid()) @db.Uuid
  group_number Int         @unique @default(autoincrement())
  name         String      @db.VarChar(255)
  description  String?     @db.Text
  teacher_id   String      @db.Uuid
  teacher      Teacher     @relation(fields: [teacher_id], references: [user_id])
  status       GroupStatus @default(active)
  group_dir    String?     @db.VarChar(64)
  invite_token String?     @db.VarChar(64)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  enrollments           Enrollment[]
  groupActivities       GroupActivity[]
  jobs                  Job[]
  instructorCertificate InstructorCertificate?
}

model Enrollment {
  id         String           @id @default(uuid()) @db.Uuid
  student_id String           @db.Uuid
  student    Student          @relation(fields: [student_id], references: [user_id])
  group_id   String           @db.Uuid
  group      Group            @relation(fields: [group_id], references: [id])
  status     EnrollmentStatus @default(active)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  @@unique([student_id, group_id])

  topicProgress     TopicProgress[]
  topicSubmissions  TopicSubmission[]
  lessonViews       LessonView[]
  groupSubmissions  GroupSubmission[]
  certificates      Certificate[]
}

// ════════════════════════════════════════
// TEMARIO ESTÁTICO
// ════════════════════════════════════════

model Topic {
  id           String   @id @default(uuid()) @db.Uuid
  order_number Int      @unique
  slug         String   @unique @db.VarChar(64)
  title        String   @db.VarChar(255)
  description  String?  @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  subtopics  Subtopic[]
  activities TopicActivity[]
  progress   TopicProgress[]
}

model Subtopic {
  id           String   @id @default(uuid()) @db.Uuid
  topic_id     String   @db.Uuid
  topic        Topic    @relation(fields: [topic_id], references: [id])
  order_number Int
  slug         String   @db.VarChar(64)
  title        String   @db.VarChar(255)
  file         String   @db.VarChar(64)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([topic_id, slug])
  @@index([topic_id])

  lessonViews  LessonView[]
  topicActivities TopicActivity[]
}

model TopicActivity {
  id           String            @id @default(uuid()) @db.Uuid
  topic_id     String            @db.Uuid
  topic        Topic             @relation(fields: [topic_id], references: [id])
  subtopic_id  String?           @db.Uuid
  subtopic     Subtopic?         @relation(fields: [subtopic_id], references: [id])
  kind         TopicActivityKind
  slug         String            @unique @db.VarChar(64)
  title        String            @db.VarChar(255)
  instructions String?           @db.Text
  difficulty   Difficulty        @default(basic)
  setup        Json?
  checks       Json
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  submissions TopicSubmission[]
  @@index([topic_id])
  @@index([subtopic_id])
}

model TopicProgress {
  id            String    @id @default(uuid()) @db.Uuid
  enrollment_id String    @db.Uuid
  enrollment    Enrollment @relation(fields: [enrollment_id], references: [id])
  topic_id      String    @db.Uuid
  topic         Topic     @relation(fields: [topic_id], references: [id])
  completed     Boolean   @default(false)
  completed_at  DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@unique([enrollment_id, topic_id])
}

model TopicSubmission {
  id                String   @id @default(uuid()) @db.Uuid
  enrollment_id     String   @db.Uuid
  enrollment        Enrollment @relation(fields: [enrollment_id], references: [id])
  topic_activity_id String   @db.Uuid
  topicActivity     TopicActivity @relation(fields: [topic_activity_id], references: [id])
  attempt_number    Int      @default(1)
  score             Int      @default(0)
  passed            Boolean  @default(false)
  auto_results      Json
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([enrollment_id, topic_activity_id])
}

model LessonView {
  id            String    @id @default(uuid()) @db.Uuid
  enrollment_id String    @db.Uuid
  enrollment    Enrollment @relation(fields: [enrollment_id], references: [id])
  subtopic_id   String    @db.Uuid
  subtopic      Subtopic  @relation(fields: [subtopic_id], references: [id])
  view_count    Int       @default(1)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@unique([enrollment_id, subtopic_id])
}

// ════════════════════════════════════════
// ACTIVIDADES DEL DOCENTE
// ════════════════════════════════════════

model GroupActivity {
  id              String         @id @default(uuid())
  activity_number Int            @unique @default(autoincrement())
  group_id        String         @db.Uuid
  group           Group          @relation(fields: [group_id], references: [id])
  title           String         @db.VarChar(255)
  instructions    String?        @db.Text
  difficulty      Difficulty     @default(basic)
  activity_type   ActivityType   @default(workshop)
  evaluation_type EvaluationType @default(automatic)
  max_score       Int            @default(100)
  setup           Json?
  checks          Json
  attempt_limit   Int?
  topic_number    Int?
  required        Boolean        @default(true)
  enabled         Boolean        @default(true)
  due_at          DateTime?
  workdir         String         @db.VarChar(64)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  submissions GroupSubmission[]
  @@index([group_id])
}

// ════════════════════════════════════════
// SUBMISSIONS UNIFICADAS
// ════════════════════════════════════════

model GroupSubmission {
  id                String           @id @default(uuid()) @db.Uuid
  enrollment_id     String           @db.Uuid
  enrollment        Enrollment       @relation(fields: [enrollment_id], references: [id])
  group_activity_id String           @db.Uuid
  groupActivity     GroupActivity    @relation(fields: [group_activity_id], references: [id])
  attempt_number    Int              @default(1)
  status            SubmissionStatus @default(submitted)
  score             Int?
  passed            Boolean          @default(false)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  autoDetail   SubmissionAutoDetail?
  manualDetail SubmissionManualDetail?
  @@index([enrollment_id, group_activity_id])
}

model SubmissionAutoDetail {
  submission_id String   @id @db.Uuid
  submission    GroupSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  auto_results  Json
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model SubmissionManualDetail {
  submission_id String   @id @db.Uuid
  submission    GroupSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  evidence      Json
  feedback      String?  @db.Text
  graded_by     String?  @db.Uuid
  grader        Teacher? @relation(fields: [graded_by], references: [user_id])
  graded_at     DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// ════════════════════════════════════════
// CERTIFICADOS
// ════════════════════════════════════════

model Certificate {
  id                String     @id @default(uuid()) @db.Uuid
  code              String     @unique @db.VarChar(32)
  enrollment_id     String     @unique @db.Uuid
  enrollment        Enrollment @relation(fields: [enrollment_id], references: [id])
  holder_name       String     @db.VarChar(255)
  holder_code       String?    @db.VarChar(20)
  group_name        String     @db.VarChar(255)
  group_number      Int
  teacher_name      String     @db.VarChar(255)
  course_started_at DateTime
  topics_completed  Int
  topics_total      Int
  definitive        Float
  issued_at         DateTime   @default(now())
}

model InstructorCertificate {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique @db.VarChar(32)
  group_id           String   @unique @db.Uuid
  group              Group    @relation(fields: [group_id], references: [id])
  holder_name        String   @db.VarChar(255)
  group_name         String   @db.VarChar(255)
  group_number       Int
  course_started_at  DateTime
  students_certified Int
  students_total     Int
  issued_at          DateTime @default(now())
}

// ════════════════════════════════════════
// JOBS UNIFICADOS
// ════════════════════════════════════════

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        JobType
  status      JobStatus @default(pending)
  priority    Int       @default(0)
  retries     Int       @default(0)
  max_retries Int       @default(3)
  error       String?   @db.Text
  user_id     String?   @db.Uuid
  user        User?     @relation(fields: [user_id], references: [id])
  group_id    String?   @db.Uuid
  group       Group?    @relation(fields: [group_id], references: [id])
  payload     Json
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([status, retries])
  @@index([group_id])
  @@index([user_id])
}

// ════════════════════════════════════════
// AUDITORÍA
// ════════════════════════════════════════

model AuditEvent {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  user       User      @relation(fields: [user_id], references: [id])
  user_role  Role
  group_id   String?   @db.Uuid
  event_type EventType
  message    String    @db.VarChar(280)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([group_id, created_at])
  @@index([event_type, created_at])
  @@index([user_id, created_at])
}
