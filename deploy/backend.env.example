# LinuxLab - backend en produccion.
# Copiar a backend/.env en el servidor y completar los valores.
# Las variables SSH_HOST/SSH_USER/SSH_KEY_PATH las inyecta el compose.

# La base es el postgres del propio stack (red interna), no una externa.
# SIN comillas: podman --env-file no las procesa como docker-compose y una URL
# entre comillas llega malformada al contenedor ("Can't reach database server").
DATABASE_URL=postgresql://linuxlab:linuxlab@postgres:5432/linuxlab

PORT=3000
NODE_ENV=production
FRONTEND_URL=https://lab.ufps.edu.co

# Email SMTP: Gmail en dev / relay de la U en produccion (solo cambiar SMTP_*)
# En dev se usa la cuenta personal; en produccion la U asigna el relay y se
# cambian SMTP_HOST/SMTP_USER/SMTP_PASS y EMAIL_FROM_ADDRESS.
EMAIL_FROM_ADDRESS=no-reply@linuxlab.local
EMAIL_FROM_NAME=LinuxLab
# SMTP prod U (cuando la U asigne relay) o SMTP de Gmail en dev
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Origenes permitidos por CORS (separados por coma). Con una sola URL publica
# y proxy por path, CORS no interviene. Con subdominios, el del frontend.
CORS_ORIGIN=http://localhost:3001

# Generar uno fuerte, p. ej.: openssl rand -hex 32
JWT_SECRET=genera-un-secreto-fuerte

# Credenciales de la cuenta de servicio de Firebase (proyecto institucional).
# FIREBASE_PRIVATE_KEY lleva saltos de linea: en el .env va entre comillas
# dobles, como en el .env de desarrollo.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=
