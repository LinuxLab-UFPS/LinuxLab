# Un solo origen para todo el laboratorio.
#
# La infraestructura de la U asigna una URL publica por puerto, pero solo hay
# una para el frontend (PORT_0). Este proxy se queda con ese puerto y reparte
# por ruta, de modo que el navegador ve una unica direccion: la del frontend.
#
# Eso ademas resuelve dos cosas de gratis: CORS no interviene (mismo origen) y
# la cookie de sesion (`SameSite: lax`) viaja sin condiciones.
#
# No termina TLS: de eso se encarga el proxy de la U, que mapea el dominio a
# este puerto. Aqui dentro todo es HTTP plano por la red de contenedores.

:3000 {
	# Cabeceras de seguridad.
	#
	# Las cuatro que la auditoria marca como ausentes con severidad alta. El
	# TLS lo termina el proxy de la U, pero estas viajan hasta el navegador tal
	# cual, porque ese proxy reenvia las cabeceras de respuesta.
	header {
		# Sin `includeSubDomains` a proposito: el dominio cuelga de
		# proyectosistemas.ufps.edu.co, compartido con el resto de proyectos de
		# la facultad, y ese flag los arrastraria a todos a HTTPS obligatorio.
		# El `max-age` arranca en un dia, que es el despliegue por etapas que
		# recomienda la propia auditoria; se sube cuando lleve tiempo estable.
		Strict-Transport-Security "max-age=86400"

		# El laboratorio no se embebe en ningun sitio.
		X-Frame-Options "DENY"

		# Nada de adivinar el tipo de un recurso por su contenido.
		X-Content-Type-Options "nosniff"

		# La ruta completa no sale hacia otros origenes; el dominio si, que es
		# lo que necesitan los servicios externos.
		Referrer-Policy "strict-origin-when-cross-origin"

		# `same-origin-allow-popups` y no `same-origin`: el login usa
		# `signInWithPopup`, y Firebase devuelve la credencial a traves de
		# `window.opener` desde la ventana emergente. Con `same-origin` ese
		# vinculo se corta y nadie puede entrar. Esta variante conserva el
		# aislamiento frente a quien nos abra a nosotros, que es lo que
		# interesa, sin romper el que abrimos nosotros.
		Cross-Origin-Opener-Policy "same-origin-allow-popups"

		# Solo informa, todavia no bloquea. Next inyecta scripts y estilos en
		# linea para hidratar, de modo que una politica estricta sin nonces
		# tumba la aplicacion. Se observa que reporta antes de imponerla.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		# El servidor no anuncia con que esta hecho.
		-Server
	}

	# `/terminal` es la pagina de Next Y el WebSocket del backend: el mismo
	# camino para dos destinos. Lo que los separa es la cabecera de upgrade,
	# que solo trae el socket. Sin este matcher habria que elegir, y elegir
	# rompe la terminal o rompe la pagina que la contiene.
	# Los comodines van sobre un trozo sin la primera letra a proposito. El
	# matcher de Caddy compara el valor tal cual, y quien manda la cabecera no
	# se pone de acuerdo con la mayuscula: curl escribe `Connection: Upgrade` y
	# nginx, por su snippet compartido, `connection: upgrade`. Con `*Upgrade*`
	# la peticion de nginx no coincidia, caia al frontend —que no habla
	# WebSocket— y la terminal se quedaba colgada sin un solo byte de vuelta.
	@terminal_ws {
		path /terminal
		header Connection *pgrade*
		header Upgrade *ebsocket*
	}
	handle @terminal_ws {
		reverse_proxy backend:3000
	}

	handle /api/* {
		reverse_proxy backend:3000
	}

	# Todo lo demas es la aplicacion, incluida la pagina /terminal.
	handle {
		reverse_proxy frontend:3000
	}
}
