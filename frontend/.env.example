# LinuxLab UFPS — variables de entorno del FRONTEND
#
# Copia este archivo a `.env.local` y complétalo. `.env.local` no se sube al repo.
# El backend tiene su propio `.env` aparte (PORT, DATABASE_URL, credenciales de
# Firebase Admin); esto es solo lo que necesita el navegador.

# Firebase Web SDK — config de tu app web (auth con Google).
# Firebase Console -> Project settings -> tus apps (Web) -> SDK setup and config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL del backend. El backend corre en :3000 por defecto (PORT en su .env).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# URL del backend vista desde el servidor de Next (Docker: nombre del servicio).
# Opcional; si falta, usa NEXT_PUBLIC_BACKEND_URL.
BACKEND_URL=http://localhost:3000

# Secreto JWT de sesion. Debe ser el MISMO valor del JWT_SECRET del backend:
# el frontend verifica los tokens que firma el backend. Sin este valor, la
# verificacion falla cerrado (todo redirige a /).
JWT_SECRET=linuxlab-jwt-secret-2026

# Base pública del CDN de videos (Cloudflare R2). Los videos no se suben al
# repo (ver .gitignore), se alojan aparte bajo la misma estructura
# tema-NN/archivo.mp4. Vacío en local: si tienes el .mp4 en public/temario/
# igual funciona, sirviéndolo localmente.
NEXT_PUBLIC_VIDEO_BASE_URL=https://pub-0374e3117e594997988cbc4dd5a83d15.r2.dev
